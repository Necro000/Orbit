# =============================================================
# Orbit — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# =============================================================

# Server
PORT=8080
NODE_ENV=development

# Auth (JWT secret keys)
JWT_SECRET=replace_with_long_random_secret_at_least_32_characters
REFRESH_SECRET=replace_with_another_long_random_secret_32_chars

# CORS
CORS_ORIGIN=http://localhost:3000

# Database
# Option A: Docker Compose (infra/docker-compose.yml) -> port 5432
# DATABASE_URL=postgres://orbit:orbit_secret@localhost:5432/orbit
# Option B: Native Local PostgreSQL (infra/LOCAL_SETUP.md) -> port 5433 (or 5432)
DATABASE_URL=postgres://orbit:orbit_secret@127.0.0.1:5433/orbit

# Supabase (primary option)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-public-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-secret-key>
SUPABASE_STORAGE_BUCKET=orbit-files

# AWS S3 (fallback / alternative to Supabase Storage)
AWS_ACCESS_KEY_ID=<your-access-key-id>
AWS_SECRET_ACCESS_KEY=<your-secret-access-key>
AWS_REGION=ap-south-1
S3_BUCKET=orbit-files-bucket

# Redis (BullMQ queue)
REDIS_URL=redis://localhost:6379

# Frontend (Next.js public vars)
NEXT_PUBLIC_API_URL=http://localhost:8080